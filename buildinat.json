{
  "version": 1,

  "project": {
    "name": "Buildinat Test App",
    "platform": "android"
  },

  "app": {
    "name": "Buildinat Test",
    "package": "com.buildinat.test",
    "versionName": "1.0.0",
    "versionCode": 1
  },

  "branding": {
    "appName": "Buildinat Test",
    "icon": "buildinat/assets/icon.png",
    "splash": "buildinat/assets/splash.png",
    "theme": {
      "primaryColor": "#000000",
      "secondaryColor": "#FFFFFF"
    }
  },

  "build": {
    "mode": "release",
    "framework": "android-gradle",
    "entry": "app",
    "target": [
      "apk",
      "aab"
    ],
    "artifact": [
      "apk",
      "aab"
    ]
  },

  "output": {
    "fileName": "Buildinat-Test-1.0.0-release"
  }
}
