{
  "version": 1,

  "project": {
    "name": "Buildinat Test App",
    "platform": "android"
  },

  "branding": {
    "appName": "Buildinat Test",
    "icon": "buildinat/assets/icon.png",
    "splash": "buildinat/assets/splash.png",
    "theme": {
      "primaryColor": "#000000",
      "secondaryColor": "#FFFFFF"
    }
  },

  "build": {
    "mode": "debug",
    "framework": "android-gradle",
    "entry": "app",
    "target": [
      "apk"
    ],
    "artifact": [
      "apk"
    ]
  }
}
